# ============================================
# SPD LOGISTICS — Environment Configuration Template
# ============================================
# Copy this file to .env or .env.local and fill in your values.
# DO NOT commit .env or .env.local to version control.
# ============================================

# Database (PostgreSQL for cloud deployment, or SQLite file for local dev)
DATABASE_URL="file:./dev.db"

# Authentication (JWT Secret key - generate a secure random 32+ character string)
JWT_SECRET="change-this-to-a-secure-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Default Admin Account (used by seed script on initial setup)
ADMIN_EMAIL="admin@spdlogistics.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_NAME="System Admin"

# Application Settings
NEXT_PUBLIC_APP_NAME="SPD Logistics"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Currency
NEXT_PUBLIC_CURRENCY="PKR"
NEXT_PUBLIC_CURRENCY_SYMBOL="₨"

# Google Gemini AI Assistant (Production API Key)
GEMINI_API_KEY=""
NEXT_PUBLIC_GEMINI_API_KEY=""

# Groq AI Customer Assistant (Get free key from https://console.groq.com)
GROQ_API_KEY=""

# ============================================
# Official Email Dispatcher Configuration (Gmail SMTP)
# ============================================
# Target Inbox: superpakdatawale@gmail.com
# To enable live delivery to superpakdatawale@gmail.com:
# 1. Log in to your Google Account (superpakdatawale@gmail.com)
# 2. Go to: Manage your Google Account -> Security -> Enable '2-Step Verification'
# 3. Search for 'App passwords' (or go to: https://myaccount.google.com/apppasswords)
# 4. Generate a new App Password named 'SPD Logistics Website'
# 5. Copy the 16-character code (e.g. 'abcd efgh ijkl mnop') and paste it in SMTP_PASS below.
# ============================================
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="465"
EMAIL_SECURE="true"
EMAIL_USER="superpakdatawale@gmail.com"
EMAIL_PASS="your-16-character-gmail-app-password"
RECEIVER_EMAIL="superpakdata@gmail.com,superpakdatawale@gmail.com"

# SMTP Aliases
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="superpakdatawale@gmail.com"
SMTP_PASS="your-16-character-gmail-app-password"
SMTP_FROM="SPD Logistics Dispatch <superpakdatawale@gmail.com>"
NOTIFICATION_EMAIL="superpakdata@gmail.com,superpakdatawale@gmail.com"
